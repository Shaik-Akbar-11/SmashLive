# Server Configuration
PORT=5001
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ponjjw1.mongodb.net/smashlive?appName=Cluster0

# Authentication
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRE=24h

# Frontend (for CORS)
FRONTEND_URL=https://smash-live.vercel.app

# Gmail SMTP OTP delivery (priority over Resend when set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=smashliveofficial@gmail.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=smashliveofficial@gmail.com

# Resend (fallback if Gmail SMTP not configured)
RESEND_API_KEY=your-resend-api-key-here

# Backend API URL (set in Vercel env vars)
VITE_API_URL=https://smashlive.onrender.com/api
